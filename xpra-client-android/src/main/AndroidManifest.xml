<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- to reconnect as soon as the network comes back -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- to ask the user to exempt the app from battery optimisations, see BackgroundRunning -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".XpraApplication"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_descriptor"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- each window has a task of its own in the recent apps, like an app,
             which goes away when the window is closed -->
        <activity
            android:name=".view.XpraActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:autoRemoveFromRecents="true" />

        <activity
            android:name=".ConnectXpraActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme.Translucent"/>

        <!-- started by the home screen icons of the server's applications: shortcuts start
             activities of their app, which do not need to be exported -->
        <activity
            android:name=".apps.LaunchAppActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/AppTheme.Translucent"/>

        <!-- Keeps the remote session alive while its windows are in the background.
             None of the predefined foreground service types fits a long-running remote
             desktop connection, and "dataSync" is limited to 6 hours a day on Android 15+. -->
        <service
            android:name=".client.XpraService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains an active remote desktop (Xpra) session while the user works in other apps"/>
        </service>
    </application>

</manifest>
