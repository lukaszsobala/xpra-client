<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".view.XpraActivity" >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:minHeight="@dimen/compact_toolbar_height"
        android:theme="@style/ThemeOverlay.Xpra.CompactToolbar"
        app:subtitleTextAppearance="@style/TextAppearance.Xpra.CompactToolbarSubtitle"
        app:titleTextAppearance="@style/TextAppearance.Xpra.CompactToolbarTitle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- pinch to zoom into the windows -->
        <com.github.jksiezni.xpra.view.ZoomLayout
            android:id="@+id/zoomLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.github.jksiezni.xpra.view.WorkspaceView
                android:id="@+id/workspaceView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </com.github.jksiezni.xpra.view.ZoomLayout>

        <!-- in landscape, where the toolbar is hidden: shows and hides it -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolbarHandle"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:layout_gravity="top|center_horizontal"
            android:alpha="0.75"
            android:contentDescription="@string/show_toolbar"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_baseline_expand_more_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <!-- while a lost connection is being restored: the windows are frozen meanwhile -->
        <LinearLayout
            android:id="@+id/reconnectingBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?attr/colorSurfaceContainerHigh"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/reconnecting"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

    </FrameLayout>

    <!-- shown above the on-screen keyboard -->
    <com.github.jksiezni.xpra.view.ExtraKeysView
        android:id="@+id/extraKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:visibility="gone"/>

</LinearLayout>