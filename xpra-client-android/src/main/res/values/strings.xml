    <!-- How to use -->
    <string name="how_to_use">How to use</string>
    <string name="help_intro">This app shows the apps of an Xpra server, which must already run on the computer you connect to, e.g. started with <tt>xpra start :100 --start=xterm</tt>. Connect over SSH with display 100, or add <tt>--bind-tcp=0.0.0.0:10000</tt> to connect over TCP (not encrypted). See <a href="https://xpra.org">xpra.org</a>.</string>
    <string name="help_servers">Servers and apps</string>
    <string name="help_add_server">Add a server and tap it to connect. "Open" shows its windows and apps.</string>
    <string name="help_pin_app">Add an app to the home screen to connect and start it in one tap. A window\'s ⋮ menu can add its app too.</string>
    <string name="help_start_command">On a connected server, + starts any command.</string>
    <string name="help_touch">Touch</string>
    <string name="help_direct_touch">Direct touch: tap to click, drag to drag, long press to right-click, drag two fingers to scroll.</string>
    <string name="help_touchpad">Touchpad: drag to move the pointer. Tap to click, tap twice to double-click, tap then drag to drag, long press or two-finger tap to right-click. This button switches modes.</string>
    <string name="help_zoom">Zoom</string>
    <string name="help_pinch">Pinch to magnify, e.g. to read small text, and drag two fingers to look around.</string>
    <string name="help_volume_keys">The volume keys resize the windows instead, keeping them sharp. The size is saved for the server (see Resolution in its settings).</string>
    <string name="help_keyboard_title">Keyboard and windows</string>
    <string name="help_keyboard">Shows the keyboard, with extra keys: Esc, Tab, Ctrl, Alt, arrows and more. Tap Ctrl then a key for Ctrl+key; long press Ctrl to lock it.</string>
    <string name="help_close">Closes the window on the server.</string>
    <string name="help_background">If the connection drops while the screen is off: ⋮ → Run in the background.</string>
