    <!-- how many screen pixels are used for one remote pixel, in percent (0 = screen density) -->
    <string-array name="resolution_names">
        <item>Automatic (matches the screen density)</item>
        <item>Full resolution (sharpest, smallest text)</item>
        <item>Scaled 125%</item>
        <item>Scaled 150%</item>
        <item>Scaled 175%</item>
        <item>Scaled 200%</item>
        <item>Scaled 225%</item>
        <item>Scaled 250%</item>
        <item>Scaled 275%</item>
        <item>Scaled 300%</item>
        <item>Scaled 350%</item>
        <item>Scaled 400%</item>
    </string-array>
    <string-array name="resolution_values">
        <item>0</item>
        <item>100</item>
        <item>125</item>
        <item>150</item>
        <item>175</item>
        <item>200</item>
        <item>225</item>
        <item>250</item>
        <item>275</item>
        <item>300</item>
        <item>350</item>
        <item>400</item>
    </string-array>

    <!-- how long to wait for the window of an app started from the phone, in seconds (0 = forever) -->
    <string-array name="app_window_timeout_names">
        <item>30 seconds</item>
        <item>1 minute</item>
        <item>2 minutes</item>
        <item>5 minutes</item>
        <item>Never give up</item>
    </string-array>
    <string-array name="app_window_timeout_values">
        <item>30</item>
        <item>60</item>
        <item>120</item>
        <item>300</item>
        <item>0</item>
    </string-array>
</resources>
