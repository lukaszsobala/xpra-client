<!-- Android 12+: saved passwords are never backed up or transferred, as their key stays in this device's keystore,
     and neither are SSH private keys -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="saved_passwords.xml" />
        <exclude domain="file" path="ssh_keys/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="saved_passwords.xml" />
        <exclude domain="file" path="ssh_keys/" />
    </device-transfer>
</data-extraction-rules>
